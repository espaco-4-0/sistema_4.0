enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int?
  durationMin Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Lesson         Lesson[]
  VisitLocation  VisitLocation[]
  CourseSchedule CourseSchedule[]
}

// Recursos do sistema que podem ser liberados para os alunos matriculados em um curso.
enum CourseResource {
  LESSONS
  PRESENCE
  CERTIFICATES
  GALLERY
  BLOG
  PROJECTS
  INVENTORY
  GAMIFICATION
}

model Course {
  id          String    @id @default(cuid())
  title       String
  description String?
  workload    Int? // em horas
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  professor   User   @relation(fields: [professorId], references: [id])
  professorId String

  Lesson         Lesson[]
  Enrollment     Enrollment[]
  CourseSchedule CourseSchedule[]
  CourseAccess   CourseAccess[]

  @@index([professorId])
}

// Agenda recorrente do curso: um registro por faixa de horário em um dia da semana.
// Múltiplos horários no mesmo dia são representados por múltiplos registros.
model CourseSchedule {
  id        String   @id @default(cuid())
  dayOfWeek Int // 0 = domingo ... 6 = sábado (mesma convenção de VisitWeekdayRule)
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  location   Location? @relation(fields: [locationId], references: [id])
  locationId String?

  @@unique([courseId, dayOfWeek, startTime])
  @@index([courseId])
  @@index([locationId])
}

// Controle de acesso granular: o que os alunos matriculados neste curso podem acessar.
model CourseAccess {
  id        String         @id @default(cuid())
  resource  CourseResource
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  @@unique([courseId, resource])
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String?
  startDate   DateTime
  durationMin Int // duração em minutos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  professor   User   @relation("ProfessorAulas", fields: [professorId], references: [id])
  professorId String

  location   Location? @relation(fields: [locationId], references: [id])
  locationId String? // opcional: pode ser definido depois

  LessonMonitor LessonMonitor[]
  Presence      Presence[]

  @@index([courseId])
  @@index([professorId])
}

model LessonMonitor {
  id        String @id @default(cuid())
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  monitor   User   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String

  assignedAt DateTime @default(now())

  @@unique([lessonId, monitorId])
  @@index([monitorId])
}

model Enrollment {
  id         String           @id @default(cuid())
  status     EnrollmentStatus @default(PENDING)
  chosenDate DateTime? // data/hora preferida pelo visitante
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  Presence Presence[]

  @@unique([userId, courseId])
  @@index([courseId])
}

model Presence {
  id          String    @id @default(cuid())
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String

  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  enrollmentId String?

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([enrollmentId])
}
