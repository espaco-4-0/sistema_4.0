enum CertificateType {
  PARTICIPATION
  COMPLETION
  EXCELLENCE
}

model CertificateTemplate {
  id          String          @id @default(uuid())
  title       String
  description String
  type        CertificateType
  workload    Int?
  layout      Json
  fileUrl     String?
  course      String?
  classId     String?
  validUntil  DateTime?
  isActive    Boolean         @default(true)
  emittedBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  emittedByUser User                      @relation("ProfessorCertificados", fields: [emittedBy], references: [id])
  inscricoes    CertificateSubscription[]
  emissoes      CertificateEmission[]

  @@index([emittedBy])
}

// Assinatura do responsável, aplicada nos certificados emitidos por ele.
model CertificateSignature {
  id                String   @id @default(uuid())
  responsibleName   String
  role              String
  signatureImageUrl String
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CertificateSubscription {
  id         String   @id @default(uuid())
  templateId String
  alunoId    String
  createdAt  DateTime @default(now())

  certificate CertificateTemplate @relation(fields: [templateId], references: [id])
  aluno       User                @relation(fields: [alunoId], references: [id])

  @@unique([templateId, alunoId])
}

model CertificateEmission {
  id               String    @id @default(uuid())
  templateId       String
  alunoId          String
  fileUrl          String
  emittedAt        DateTime  @default(now())
  emittedBy        String
  validUntil       DateTime?
  lastDownloadedAt DateTime?
  totalDownloads   Int       @default(0)
  course           String

  certificate CertificateTemplate @relation(fields: [templateId], references: [id])
  aluno       User                @relation(fields: [alunoId], references: [id])

  @@unique([templateId, alunoId])
}
